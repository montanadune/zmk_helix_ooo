// OS設定を日本語キーボードのまま使用するための変換定義
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角
#define JP_CAPS         LS(JP_EISU)       // Caps Lock

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            //        ,-----------------------------------------.
            //        |   {  |   <  |   (  |   [  |   ;  |  C+z |
            //        |------+------+------+------+------+------|
            //        |   F  |   A  |   K  |   R  |   P  |全/半 |
            //        |------+------+------+------+------+------|
            //        |   E  |   I  |   S  |   T  |   D  |  BS  |
            // ,------+------+------+------+------+------+------|
            // |Space |   O  |   U  |   N  |   H  |   Y  | Shift|
            // |------+------+------+------+------+------+------|
            // | Ent  | OPT  | Num  | Sym  | Lyr4 | Alt  | Ctrl |
            // `------------------------------------------------'
            bindings = <
                  &kp JP_LBRACE &kp LT       &kp JP_LPAREN &kp JP_LBRACKET &kp SEMI   &kp LC(Z)
                  &kp F         &kp A        &kp K         &kp R           &kp P      &kp JP_HANZEN
                  &kp E         &kp I        &kp S         &kp T           &kp D      &kp BSPC
&kp SPACE         &kp O         &kp U        &kp N         &kp H           &kp Y      &sk LSHIFT
&kp RET           &mo 1         &mo 2        &mo 3         &mo 4           &kp LALT   &sk LCTRL
            >;
        };

        opt_layer {
            display-name = "Opt";
            //        ,-----------------------------------------.
            //        |   }  |   >  |   )  |   ]  |   :  |  Esc |
            //        |------+------+------+------+------+------|
            //        |  Tab |   '  |   B  |   M  |   J  | 英数 |
            //        |------+------+------+------+------+------|
            //        |   Q  |   Z  |   L  |   C  |   V  |  Del |
            // ,------+------+------+------+------+------+------|
            // | Esc  |  Del |   -  |   W  |   G  |   X  | CAPS |
            // |------+------+------+------+------+------+------|
            // |      |      |      |      |      |      |   .  |
            // `------------------------------------------------'
            bindings = <
                  &kp JP_RBRACE &kp GT       &kp JP_RPAREN &kp JP_RBRACKET &kp SINGLE_QUOTE &kp ESC
                  &kp TAB       &kp JP_QUOTE &kp B         &kp M           &kp J            &kp JP_EISU
                  &kp Q         &kp Z        &kp L         &kp C           &kp V            &kp DEL
&kp ESC           &kp DEL       &kp MINUS    &kp W         &kp G           &kp X            &kp JP_CAPS
&trans            &trans        &trans       &trans        &trans          &trans           &kp DOT
            >;
        };

        num_layer {
            display-name = "Num";
            //        ,-----------------------------------------.
            //        |  Tab |  END | HOME |      |      |      |
            //        |------+------+------+------+------+------|
            //        |   -  |   7  |   8  |   9  |   *  |   `  |
            //        |------+------+------+------+------+------|
            //        |   +  |   4  |   5  |   6  |   /  |      |
            // ,------+------+------+------+------+------+------|
            // |      |   0  |   1  |   2  |   3  |CS+F1 |NumLk |
            // |------+------+------+------+------+------+------|
            // |      |      |   0  |   ,  |   .  |      |      |
            // `------------------------------------------------'
            bindings = <
                  &kp TAB       &kp END      &kp HOME      &trans          &trans           &trans
                  &kp MINUS     &kp N7       &kp N8        &kp N9          &kp JP_ASTERISK  &kp GRAVE
                  &kp JP_PLUS   &kp NUMBER_4 &kp N5        &kp NUMBER_6    &kp SLASH        &trans
&trans            &kp N0        &kp NUMBER_1 &kp NUMBER_2  &kp NUMBER_3    &kp LS(LC(F1))   &kp KP_NUMLOCK
&trans            &trans        &kp N0       &kp COMMA     &kp PERIOD      &trans           &trans
            >;
        };

        sym_layer {
            display-name = "Sym";
            //        ,-----------------------------------------.
            //        |   ^  |  PD  |  PU  |      |   !  |  Ins |
            //        |------+------+------+------+------+------|
            //        |   %  |   ?  |   =  |   #  |   \  |      |
            //        |------+------+------+------+------+------|
            //        |   |  |   !  |   @  |   ↑  |OUT_TG|BT_NXT|
            // ,------+------+------+------+------+------+------|
            // |   {  |   &  |   _  |  <-  |   ↓  |  ->  | CAPS |
            // |------+------+------+------+------+------+------|
            // |      |   ¥  |   ~  |      |  PS  |      |      |
            // `------------------------------------------------'
            bindings = <
                  &kp JP_CARET     &kp PG_DN      &kp PAGE_UP    &trans         &kp EXCL             &kp INSERT
                  &kp PERCENT      &kp QUESTION   &kp JP_EQUAL   &kp HASH       &kp NON_US_BACKSLASH &trans
                  &kp PIPE         &kp EXCLAMATION &kp AT_SIGN   &kp UP_ARROW   &out OUT_TOG         &bt BT_NXT
&kp LBRC          &kp JP_AMPERSAND &kp UNDERSCORE &kp LEFT_ARROW &kp DOWN_ARROW &kp RIGHT_ARROW      &kp CAPS
&trans            &kp JP_YEN       &kp TILDE      &trans         &kp PRINTSCREEN &trans              &trans
            >;
        };

        func_layer {
            display-name = "Func";
            //        ,-----------------------------------------.
            //        |      | F12  | F11  | F10  |      |BT_CLR|
            //        |------+------+------+------+------+------|
            //        |      |  F9  |  F8  |  F7  |      |BTDSC0|
            //        |------+------+------+------+------+------|
            //        |      |  F6  |  F5  |  F4  |      |BTCLRA|
            // ,------+------+------+------+------+------+------|
            // |      |      |  F3  |  F2  |  F1  |      |      |
            // |------+------+------+------+------+------+------|
            // |      |      |      |      |      |      |      |
            // `------------------------------------------------'
            bindings = <
                  &trans        &kp F12      &kp F11       &kp F10         &trans           &bt BT_CLR
                  &trans        &kp F9       &kp F8        &kp F7          &trans           &bt BT_DISC 0
                  &trans        &kp F6       &kp F5        &kp F4          &trans           &bt BT_CLR_ALL
&trans            &trans        &kp F3       &kp F2        &kp F1          &trans           &trans
&trans            &trans        &trans       &trans        &trans          &trans           &trans
            >;
        };

        layer_5 {
            display-name = "Extra";
            bindings = <
                  &trans        &trans       &trans        &trans          &trans           &trans
                  &trans        &trans       &trans        &trans          &trans           &trans
                  &trans        &trans       &trans        &trans          &trans           &trans
&trans            &trans        &trans       &trans        &trans          &trans           &trans
&trans            &trans        &trans       &trans        &trans          &trans           &studio_unlock
            >;
        };
    };
};
